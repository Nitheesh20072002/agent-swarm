
# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ai_agent_swarm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/ai_agent_swarm

# Database Pool Configuration (Phase 3 Optimization)
DB_POOL_MAX=20              # Maximum number of connections
DB_POOL_MIN=2               # Minimum number of connections
DB_IDLE_TIMEOUT=30000       # Idle connection timeout (ms)
DB_CONNECTION_TIMEOUT=2000  # Connection timeout (ms)
DB_QUERY_TIMEOUT=30000      # Query timeout (ms)

# Backend Configuration
NODE_ENV=production
PORT=3000
SERVER_URL=  # Optional: Set to your public backend URL (e.g., https://your-service.run.app). Matches frontend's NEXT_PUBLIC_API_URL. Leave empty for localhost.
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration (add frontend port 5173 for local development)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Agent Configuration
AGENT_ID=alice
AGENT_TOKEN=your_agent_jwt_token_here
BACKEND_URL=http://localhost:3000
WEBSOCKET_URL=ws://localhost:3000

# LLM Configuration (choose one)
LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=openrouter

# OpenRouter Configuration (supports free models)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_APP_NAME=ai-agent-swarm
OPENROUTER_SITE_URL=http://localhost:3000

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Context Management Settings
MAX_CONTEXT_TOKENS=4000
CONTEXT_SUMMARY_THRESHOLD=0.8
ENABLE_CONTEXT_COMPRESSION=true

# Model Defaults
DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000

# Enhanced Features (Phase 3)
USE_ENHANCED_REGISTRY=true  # Enable retry logic and fallback models

# Agent Workspace
WORKSPACE_PATH=/workspace
LOG_LEVEL=INFO

# Optional: Email Notifications (for future notification service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=noreply@yourdomain.com
